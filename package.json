{
    "name": "byaflux-dev",
    "version": "0.1.26",
    "private": true,
    "description": "ByaFlux: comandos de desenvolvimento na raiz do projeto",
    "scripts": {
        "postinstall": "node scripts/dev.mjs install",
        "build": "node scripts/dev.mjs build",
        "inject": "node mod/scripts/runInstaller.mjs -- --install",
        "uninject": "node mod/scripts/runInstaller.mjs -- --uninstall",
        "repair": "node mod/scripts/runInstaller.mjs -- --repair",
        "typecheck": "node scripts/dev.mjs typecheck"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.18.0"
}
